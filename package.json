{
  "name": "vernacular-crm",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck && pnpm typecheck:e2e",
    "typecheck:e2e": "tsc -p tests/e2e",
    "test": "turbo run test",
    "db:up": "pnpm --filter @vernacular/db db:up",
    "db:migrate": "pnpm --filter @vernacular/db db:migrate",
    "jobs:install": "pnpm --filter @vernacular/api jobs:install",
    "db:seed": "pnpm --filter @vernacular/api seed",
    "db:rollback": "pnpm --filter @vernacular/db db:rollback",
    "db:new": "pnpm --filter @vernacular/db db:new",
    "db:codegen": "pnpm --filter @vernacular/db db:codegen",
    "db:reset": "pnpm --filter @vernacular/db db:reset",
    "db:roundtrip": "pnpm --filter @vernacular/db db:roundtrip",
    "check:public-schema": "bash scripts/check-no-public-schema.sh",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
