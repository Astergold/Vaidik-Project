# Copy this to infra/.env for local/staging and fill in real values.
# infra/.env is gitignored (.env / .env.* with !.env.example) — never commit it.
# These are placeholders only. Real values live in the password manager / CI secrets.

# Prefix docker compose uses for container + volume names (use 'vernacular-prod' on the production VPS)
COMPOSE_PROJECT_NAME=vernacular-staging

# Postgres container superuser. Migrations/reports connect as crm_owner, request code as crm_app
# (see AGENTS.md "Database rules"); those roles are created by the migrations, not by this image.
POSTGRES_USER=crm_admin
POSTGRES_PASSWORD=change-me-in-your-local-env
POSTGRES_DB=crm

# --- Calling platform (campaigns are created in the CRM and mirrored there) -------------------
# Base URL of the calling platform API (Appendix D).
DOGRAH_BASE_URL=https://godrah.laveric.com
# Global platform key: dev/staging fallback ONLY, ignored when NODE_ENV=production.
# Production uses each tenant's own key, stored encrypted in crm.tenant_secret (kind dograh_api_key).
DOGRAH_PLATFORM_KEY=
# Deprecated aliases still accepted (a warning is logged): GODRAH_API_BASE_URL, GODRAH_API_KEY,
# DOGRAH_API_BASE_URL, DOGRAH_API_KEY.
