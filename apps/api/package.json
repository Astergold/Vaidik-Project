{
  "name": "@vernacular/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "jobs:install": "tsx --env-file-if-exists=../../.env src/jobs/install-cli.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/seed.ts"
  },
  "dependencies": {
    "@fastify/formbody": "^9.0.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@vernacular/contracts": "workspace:*",
    "@vernacular/db": "workspace:*",
    "@vernacular/integration-dograh": "workspace:^",
    "@vernacular/policy": "workspace:*",
    "better-auth": "^1.7.7",
    "fastify": "^5.2.0",
    "fastify-type-provider-zod": "^7.0.0",
    "kysely": "^0.29.6",
    "pg": "^8.13.1",
    "pg-boss": "^12.37.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "dotenv": "^16.4.7",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "exports": {
    "./jobs": "./src/jobs/index.ts",
    "./config": "./src/config.ts",
    "./secrets": "./src/modules/secrets/service.ts",
    "./dialer": "./src/modules/calls/dialer.ts",
    "./platform": "./src/modules/campaigns/platform.ts"
  }
}
